{
  "id": null,
  "uid": "code-execution-main",
  "title": "Distributed Code Execution Platform",
  "tags": ["code-execution", "distributed", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Queue Backlog (Pending Jobs)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "max(code_execution_queue_depth)",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Workers",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(code_execution_active_workers)",
          "legendFormat": "Active Workers",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active WebSocket Connections",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(code_execution_websocket_connections_active)",
          "legendFormat": "WebSocket Connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Dead Letter Queue Volume",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(code_execution_dead_letter_jobs_total)",
          "legendFormat": "DLQ Jobs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Dead Worker Recoveries",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(code_execution_dead_worker_recoveries_total)",
          "legendFormat": "Recoveries",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Rate Limit Hits",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(code_execution_rate_limit_hits_total)",
          "legendFormat": "Rate Limit Hits",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Execution Latency (P50/P90/P99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(code_execution_duration_ms_bucket[1m])) by (le))",
          "legendFormat": "P50 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(code_execution_duration_ms_bucket[1m])) by (le))",
          "legendFormat": "P90 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(code_execution_duration_ms_bucket[1m])) by (le))",
          "legendFormat": "P99 Latency",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "title": "Job Throughput by Status",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(code_execution_worker_jobs_total[1m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Queue Depth Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "max(code_execution_queue_depth)",
          "legendFormat": "Pending Queue Depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "WebSocket Events (Connect / Disconnect / Error)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(code_execution_websocket_events_total[1m])) by (event)",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Dequeue Latency (P99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(code_execution_dequeue_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "P99 Dequeue Latency",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "DLQ & Recovery Spikes",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(code_execution_dead_letter_jobs_total[1m]))",
          "legendFormat": "DLQ Rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(code_execution_dead_worker_recoveries_total[1m]))",
          "legendFormat": "Recovery Rate",
          "refId": "B"
        }
      ]
    }
  ]
}
